# Meta 개발자 앱 > Threads API 설정에서 확인
THREADS_APP_ID=
THREADS_APP_SECRET=
# 배포 주소 (끝에 / 없이). 예: https://my-threads.vercel.app
APP_URL=http://localhost:3000
# 세션 쿠키 암호화 키. 32자 이상 아무 문자열 (예: openssl rand -hex 32)
SESSION_SECRET=
# Postgres 연결 주소 (Vercel에서 Neon을 연결하면 자동으로 들어갑니다)
DATABASE_URL=
# 하루 1회 자동 댓글 수집용 비밀값. 아무 긴 문자열
CRON_SECRET=
# Claude API 키 (AI 분석, 인물 정보 추출, 답글 검사용)
ANTHROPIC_API_KEY=
# 분석할 최근 게시글 최대 개수 (기본 150)
MAX_POSTS=150
